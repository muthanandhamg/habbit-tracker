# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/life-os

# CORS: comma-separated browser origins allowed to call the API.
# Leave empty when frontend and API share one domain (reverse proxy on /api).
# CORS_ORIGIN=https://app.example.com

# Seed admin user: created with demo data on first start ONLY if the DB is empty
# and both values are set. Leave unset in production unless you need it.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change_me_strong_password

# JWT Authentication
JWT_SECRET=your_secure_secret_key

# AI Provider Configuration
# Set to 'huggingface' or 'gemini'
AI_PROVIDER=huggingface

# Hugging Face Configuration (required when AI_PROVIDER=huggingface)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token
# Optional: Override the default model
# HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# Gemini Configuration (required when AI_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key
